# AgentOS 内核基础镜像
# 包含编译内核所需的所有依赖和工具

FROM ubuntu:24.04 AS base

LABEL maintainer="SPHARX Team <devops@spharx.cn>"
LABEL version="0.1.0"
LABEL description="AgentOS Kernel Base Image"

# CUDA 路径配置（可通过 --build-arg CUDA_HOME=... 覆盖）
ARG CUDA_HOME=/usr/local/cuda

# 环境变量设置
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CMAKE_VERSION=3.28.0 \
    CUDA_HOME=${CUDA_HOME} \
    PATH=${CUDA_HOME}/bin:$PATH

# === 1. 安装系统依赖 ===
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    # 编译工具链
    build-essential \
    gcc \
    g++ \
    make \
    # CMake 和 Ninja
    cmake \
    ninja-build \
    # Git 和下载工具
    git \
    wget \
    curl \
    ca-certificates \
    unzip \
    # SSL 和加密库
    libssl-dev \
    openssl \
    # libevent (事件驱动)
    libevent-dev \
    # 线程库
    libpthread-stubs0-dev \
    # SQLite3 (元数据存储)
    libsqlite3-dev \
    sqlite3 \
    # libcurl (HTTP 客户端)
    libcurl4-openssl-dev \
    # JSON 解析
    libcjson-dev \
    # YAML 解析
    libyaml-dev \
    # HTTP 服务器
    libmicrohttpd-dev \
    # WebSocket
    libwebsockets-dev \
    # UUID（coreloopthree id_utils 依赖）
    uuid-dev \
    # 开发工具
    pkg-config \
    gdb \
    valgrind \
    clang \
    clang-format \
    clang-tidy \
    # 文档生成
    doxygen \
    graphviz \
    # 清理缓存
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 时区设置（必须在 tzdata 安装完成后执行）
RUN ln -fs /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    dpkg-reconfigure -f noninteractive tzdata

# === 2. 安装 CMake 最新版本（按架构下载） ===
WORKDIR /tmp
ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
        amd64)  CMAKE_ARCH="x86_64" ;; \
        arm64)  CMAKE_ARCH="aarch64" ;; \
        *)      echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    wget -q https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-${CMAKE_ARCH}.tar.gz \
    && tar -xzf cmake-*.tar.gz \
    && mv cmake-${CMAKE_VERSION}-linux-${CMAKE_ARCH} /opt/cmake \
    && ln -s /opt/cmake/bin/cmake /usr/local/bin/cmake \
    && ln -s /opt/cmake/bin/ctest /usr/local/bin/ctest \
    && ln -s /opt/cmake/bin/cpack /usr/local/bin/cpack \
    && rm -rf cmake-*

# === 3. 安装 Ninja Build ===
# ninja-build 已由 apt 在第 1 步安装（自动匹配架构），无需手动下载二进制

# === 4. 设置工作目录 ===
WORKDIR /workspace

# === 5. 构建阶段 ===
FROM base AS builder

WORKDIR /workspace

# 复制源代码
COPY . ./AgentOS/

# BAN-33: 构建目录在源码树外
RUN mkdir -p /workspace/AgentOS-build \
    && cmake -S /workspace/AgentOS -B /workspace/AgentOS-build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTS=OFF \
    -DENABLE_SANITIZERS=OFF \
    -DWARNINGS_AS_ERRORS=OFF \
    -DCMAKE_INSTALL_PREFIX=/opt/agentos \
    -G Ninja \
    && cmake --build /workspace/AgentOS-build --parallel $(nproc) \
    && cmake --install /workspace/AgentOS-build

# === 6. 运行时阶段 ===
FROM ubuntu:24.04 AS runtime

LABEL maintainer="SPHARX Team <devops@spharx.cn>"
LABEL version="0.1.0"
LABEL description="AgentOS Kernel Runtime Image"

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    AGENTOS_ROOT=/opt/agentos \
    PATH=/opt/agentos/bin:$PATH

ENV LD_LIBRARY_PATH=/opt/agentos/lib

# 安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    libssl3t64 \
    libevent-2.1-7t64 \
    libsqlite3-0 \
    libcjson1 \
    libcurl4t64 \
    libyaml-0-2 \
    libmicrohttpd12t64 \
    libwebsockets19t64 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 时区设置（必须在 tzdata 安装完成后执行）
RUN ln -fs /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    dpkg-reconfigure -f noninteractive tzdata

# 从构建阶段复制已安装的文件
COPY --from=builder /opt/agentos /opt/agentos

# 创建数据目录
RUN mkdir -p /var/log/agentos \
    && mkdir -p /var/lib/agentos/registry \
    && mkdir -p /var/lib/agentos/traces \
    && chmod 755 /var/log/agentos \
    && chmod 755 /var/lib/agentos

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pgrep -x agentos || exit 1

WORKDIR /opt/agentos

# 默认命令
CMD ["/bin/bash"]